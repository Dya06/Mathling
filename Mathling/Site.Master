<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Site.master.cs" Inherits="Mathling.SiteMaster" %>

<!DOCTYPE html>

<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title><%: Page.Title %> - Mathlings</title>

    <link rel="icon" type="image/svg+xml" href="<%=ResolveUrl("~/favicon.svg")%>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet" href="<%=ResolveUrl("~/css/variables.css?v=4")%>" />
    <link rel="stylesheet" href="<%=ResolveUrl("~/css/base.css?v=4")%>" />
    <link rel="stylesheet" href="<%=ResolveUrl("~/css/components.css?v=4")%>" />
    <link rel="stylesheet" href="<%=ResolveUrl("~/css/layout.css?v=4")%>" />

    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server">
        <asp:ScriptManager runat="server" EnablePageMethods="true">
            <Scripts>
                <asp:ScriptReference Name="jquery" />
            </Scripts>
        </asp:ScriptManager>

        <asp:ContentPlaceHolder ID="MainContent" runat="server" />
    </form>

    <% if (Session["UserId"] != null) { %>
    <script>
        // Bridge ASP.NET Session into frontend JavaScript session
        const sessionUser = {
            id: '<%= Session["UserId"] %>',
            name: '<%= Session["UserName"] %>',
            role: '<%= Session["UserRole"] %>',
            email: '<%= Session["UserEmail"] %>',
            avatar: '<%= Session["UserRole"]?.ToString() == "student" ? "\\uD83E\\uDDD2" : Session["UserRole"]?.ToString() == "parent" ? "\\uD83D\\uDC69" : Session["UserRole"]?.ToString() == "instructor" ? "\\uD83D\\uDC68\\u200D\\uD83C\\uDFEB" : "\\uD83D\\uDEE1\\uFE0F" %>',
            level: 1,
            xp: 0
        };
        localStorage.setItem('mathlings-user', JSON.stringify(sessionUser));
    </script>
    <% } else { %>
    <script>
        // Clear local storage if server session is null, except on login page
        if (window.location.pathname.toLowerCase().indexOf('login.aspx') === -1) {
            localStorage.removeItem('mathlings-user');
        }
    </script>
    <% } %>

    <asp:ContentPlaceHolder ID="ScriptContent" runat="server" />
</body>
</html>
